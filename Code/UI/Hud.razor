@using Sandbox;
@using Sandbox.UI;
@using NarutoRp.Player;
@using NarutoRp.Combat;
@inherits PanelComponent
@namespace NarutoRp.UI

@* HUD du joueur local : jauges et barre de jutsus. Lecture seule, aucune logique de jeu. *@
<root>
	@if ( Stats is not null )
	{
		<div class="gauges">
			@foreach ( var (kind, value, max) in Gauges() )
			{
				<div class="gauge @kind">
					<div class="fill" style="width: @(max > 0 ? value / max * 100f : 0)%"></div>
					<div class="value">@MathF.Round( value ) / @max</div>
				</div>
			}
		</div>

		@if ( Defense is not null )
		{
			<div class="defense">
				@if ( Defense.IsGuarding ) { <div class="tag guard">Garde</div> }
				@if ( Defense.IsSubstitutionReady ) { <div class="tag sub">Substitution prête</div> }
				<div class="tag @(Defense.SubstitutionCooldownRemaining > 0 ? "off" : "")">@Input.GetButtonOrigin( "Substitution" ) Substitution @(Defense.SubstitutionCooldownRemaining > 0 ? $"({MathF.Ceiling( Defense.SubstitutionCooldownRemaining )})" : "")</div>
			</div>
		}

		@if ( ActiveRevive is not null )
		{
			<div class="revive">
				<div class="text">@(ActiveRevive == Revive ? "Soins en cours…" : "Un médic-nin vous soigne…")</div>
				<div class="bar"><div class="fill" style="width: @(ActiveRevive.ReviveProgress * 100f)%"></div></div>
			</div>
		}

		@if ( Notice is not null )
		{
			<div class="notice">@Notice</div>
		}

		@if ( Stats.IsDowned )
		{
			<div class="state downed">À terre — attendez un médic-nin</div>
		}
		else if ( Stats.IsStunned )
		{
			<div class="state">Étourdi</div>
		}

		@if ( Caster is not null )
		{
			<div class="jutsus">
				@for ( var i = 0; i < Caster.Slots.Count; i++ )
				{
					var j = Caster.Slots[i];
					var cd = j is null ? 0f : Caster.CooldownRemaining( j );
					<div class="slot @(Caster.Casting == j ? "casting" : "") @(cd > 0 ? "cooldown" : "")">
						<div class="key">@(i + 1)</div>
						@if ( cd > 0 )
						{
							<div class="cd">@MathF.Ceiling( cd )</div>
						}
						<div class="name">@(j?.DisplayName ?? "-")</div>
						<div class="cost">@(j?.ChakraCost ?? 0)</div>
					</div>
				}
			</div>
		}
	}
</root>

@code
{
	NinjaStats Stats => NinjaPlayer.Local?.GetComponent<NinjaStats>();
	JutsuCaster Caster => NinjaPlayer.Local?.GetComponent<JutsuCaster>();
	NinjaDefense Defense => NinjaPlayer.Local?.GetComponent<NinjaDefense>();

	/// <summary>Message du staff ou retour d'action, affiché 6 s.</summary>
	string Notice
	{
		get
		{
			var c = NinjaPlayer.Local?.GetComponent<NarutoRp.Staff.StaffCommands>();
			return c?.Notice is not null && c.NoticeAge < 6f ? c.Notice : null;
		}
	}
	ReviveAction Revive => NinjaPlayer.Local?.GetComponent<ReviveAction>();

	/// <summary>Relève en cours où le joueur local est soigneur ou blessé.</summary>
	ReviveAction ActiveRevive => Revive?.ReviveTarget is not null ? Revive
		: Scene.GetAllComponents<ReviveAction>().FirstOrDefault( r => r.ReviveTarget is not null && r.ReviveTarget == Stats );

	(string, float, float)[] Gauges() => new[]
	{
		("health", Stats.Health, Stats.MaxHealth),
		("chakra", Stats.Chakra, Stats.MaxChakra),
		("stamina", Stats.Stamina, Stats.MaxStamina),
	};

	protected override int BuildHash()
	{
		var s = Stats;
		var c = Caster;
		return System.HashCode.Combine(
			MathF.Round( s?.Health ?? 0 ), MathF.Round( s?.Chakra ?? 0 ), MathF.Round( s?.Stamina ?? 0 ),
			System.HashCode.Combine( s?.IsDowned, s?.IsStunned, c?.Casting, Notice ),
			System.HashCode.Combine( Defense?.IsGuarding, Defense?.IsSubstitutionReady, MathF.Ceiling( Defense?.SubstitutionCooldownRemaining ?? 0 ),
				ActiveRevive, MathF.Round( (ActiveRevive?.ReviveProgress ?? 0) * 50 ) ),
			c?.Slots.Sum( j => j is null ? 0f : MathF.Ceiling( c.CooldownRemaining( j ) ) ) );
	}
}
