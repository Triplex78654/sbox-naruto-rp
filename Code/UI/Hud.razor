@using Sandbox;
@using Sandbox.UI;
@using NarutoRp.Player;
@using NarutoRp.Combat;
@using NarutoRp.Characters;
@using NarutoRp.Missions;
@using NarutoRp.Jutsus;
@inherits PanelComponent
@namespace NarutoRp.UI

@* HUD Ninja complet : Portrait, PV, Chakra, Ryô, Buffs/Debuffs, Kunai, et Barre de 6 Jutsus avec pagination *@
<root>
	@if ( Stats is not null && GameSettings.HudVisible )
	{
		<!-- ================= BLOC IDENTITÉ & STATS (BAS GAUCHE) ================= -->
		<div class="hud-profile-card" style="transform: scale( @GameSettings.HudScale ); transform-origin: left bottom;">
			<!-- Portrait & Village -->
			<div class="avatar-frame @Me.Village">
				<div class="avatar-portrait" @ref="PortraitPanel"></div>
				<div class="avatar-village">@VillageIcon( Me.Village )</div>
				<div class="avatar-rank-badge">@RankShort( Me.Grade )</div>
			</div>

			<!-- Informations identité & stats -->
			<div class="profile-details">
				<div class="identity-header">
					<div class="identity-name-row">
						<div class="ninja-name">@Me.CharacterName</div>
						<div class="ninja-level-badge">@($"Niv. {Me.Level}")</div>
					</div>
					<div class="ninja-title">@($"{CharacterRules.Label( Me.Village )} · {CharacterRules.Label( Me.Grade )}{(Me.IsMedic ? " · Médic-nin" : "")}")</div>

					<!-- Progression vers le prochain niveau Shinobi -->
					<div class="level-progress-container" title="@LevelTooltip">
						<div class="level-progress-track">
							<div class="level-progress-fill" style="width: @(Me.LevelProgress * 100f)%"></div>
						</div>
						<div class="level-progress-info">
							<span class="level-next-label">@LevelProgressText</span>
						</div>
					</div>

					<div class="ninja-ryo">
						<span class="ryo-icon">🪙</span>
						<span class="ryo-amount">@($"{Me.Ryo:N0} 両")</span>
					</div>
				</div>

				<!-- Jauge de Vie -->
				<div class="gauge-bar health">
					<div class="fill" style="width: @(HealthPct * 100f)%"></div>
					<div class="gauge-glow"></div>
					<div class="gauge-content">
						<span class="gauge-label">PV</span>
						<span class="gauge-numbers">@($"{MathF.Round( Stats.Health )} / {Stats.MaxHealth}")</span>
					</div>
				</div>

				<!-- Jauge de Chakra -->
				<div class="gauge-bar chakra">
					<div class="fill" style="width: @(ChakraPct * 100f)%"></div>
					<div class="gauge-glow"></div>
					<div class="gauge-content">
						<span class="gauge-label">CHAKRA</span>
						<span class="gauge-numbers">@($"{MathF.Round( Stats.Chakra )} / {Stats.MaxChakra}")</span>
					</div>
				</div>

				<!-- Buffs / Debuffs & Défenses -->
				<div class="status-badges">
					@if ( Stats.IsDowned ) { <div class="badge alert pulse">À terre</div> }
					else if ( Stats.IsStunned ) { <div class="badge alert">Étourdi</div> }
					@if ( Me.GetComponent<NinjaMovement>()?.IsNinjaRunning == true ) { <div class="badge buff">Course ninja</div> }
					@if ( Defense?.IsGuarding == true ) { <div class="badge defense">Garde</div> }
					@if ( Defense?.IsSubstitutionReady == true ) { <div class="badge active">Subst. Prête [Z]</div> }
					else if ( (Defense?.SubstitutionCooldownRemaining ?? 0) > 0 ) { <div class="badge cooldown">@($"Subst. {MathF.Ceiling( Defense.SubstitutionCooldownRemaining )}s")</div> }
					@if ( Kunai is not null )
					{
						@if ( Kunai.IsDrawn )
						{
							@if ( Kunai.ThrowCooldownRemaining <= 0 ) { <div class="badge active" onclick=@(() => Kunai.RequestToggleDrawn()) title="Kunai en main · Clic gauche taillade, [R] lancer. Appuyez sur [H] pour ranger">Kunai [H] (Prêt [R])</div> }
							else { <div class="badge cooldown" onclick=@(() => Kunai.RequestToggleDrawn()) title="Kunai en main · Appuyez sur [H] pour ranger">@($"Kunai [H] ({MathF.Ceiling( Kunai.ThrowCooldownRemaining )}s)")</div> }
						}
						else
						{
							<div class="badge neutral" onclick=@(() => Kunai.RequestToggleDrawn()) title="Mains nues · Clic gauche coup de poing. Appuyez sur [H] pour dégainer">Mains nues [H]</div>
						}
					}
					@if ( Shuriken is not null )
					{
						@if ( Shuriken.ThrowCooldownRemaining <= 0 ) { <div class="badge active" title="Lancer une volée de 3 shurikens en éventail [B]">@($"Shuriken [B]{(Inventory is not null ? $" x{Inventory.ShurikenCount}" : "")}")</div> }
						else { <div class="badge cooldown" title="Rechargement des shurikens">@($"Shuriken {MathF.Ceiling( Shuriken.ThrowCooldownRemaining )}s")</div> }
					}
					@if ( Consumables is not null )
					{
						@if ( Consumables.DeployedTagCount > 0 ) { <div class="badge alert pulse" title="Faire détoner les parchemins posés">@($"Katsu [T] ({Consumables.DeployedTagCount})")</div> }
						@if ( Consumables.ExplosiveTagCooldownRemaining <= 0 && Consumables.DeployedTagCount < NinjaConsumables.MaxExplosiveTags ) { <div class="badge active" title="Poser un parchemin explosif sur un mur ou sol">@($"Tag [F]{(Inventory is not null ? $" x{Inventory.ExplosiveTagCount}" : "")}")</div> }
						else if ( Consumables.ExplosiveTagCooldownRemaining > 0 ) { <div class="badge cooldown">@($"Tag {MathF.Ceiling( Consumables.ExplosiveTagCooldownRemaining )}s")</div> }
						@if ( Consumables.SmokeBombCooldownRemaining <= 0 ) { <div class="badge active" title="Lancer une bombe fumigène">@($"Fumigène [G]{(Inventory is not null ? $" x{Inventory.SmokeBombCount}" : "")}")</div> }
						else { <div class="badge cooldown">@($"Fumigène {MathF.Ceiling( Consumables.SmokeBombCooldownRemaining )}s")</div> }
					}
					@if ( Inventory is not null )
					{
						@if ( Inventory.SoldierPillCooldown <= 0 ) { <div class="badge active" title="Pilule du soldat : +45 PV et +45 chakra">@($"Pilule [J] x{Inventory.SoldierPillCount}")</div> }
						else { <div class="badge cooldown">@($"Pilule {MathF.Ceiling( Inventory.SoldierPillCooldown )}s")</div> }
					}
					@if ( Me.GetComponent<NarutoRp.Staff.StaffCommands>() is { IsFlying: true } fly ) { <div class="badge staff">@($"Vol staff ({fly.FlySpeed:0})")</div> }
				</div>
			</div>
		</div>

		<!-- ================= BARRE D'INCANTATION (CENTRE) ================= -->
		@if ( Caster?.Casting is not null )
		{
			<div class="cast-container">
				<div class="cast-name">@Caster.Casting.DisplayName</div>
				<div class="cast-track">
					<div class="cast-fill" style="width: @(CastProgress * 100f)%; background-color: @Css( Caster.Casting.FxColor )"></div>
				</div>
			</div>
		}

		<!-- ================= RELÈVE EN COURS ================= -->
		@if ( ActiveRevive is not null )
		{
			<div class="revive-container">
				<div class="revive-text">@(ActiveRevive == Revive ? "Soins médicaux en cours…" : "Un médic-nin vous soigne…")</div>
				<div class="revive-track">
					<div class="revive-fill" style="width: @(ActiveRevive.ReviveProgress * 100f)%"></div>
				</div>
			</div>
		}

		<!-- ================= NOTICES / ALIGNEMENT STAFF ================= -->
		@if ( Notice is not null )
		{
			<div class="hud-notice">@Notice</div>
		}

		<!-- ================= BARRE DE 6 JUTSUS & PAGINATION (BAS CENTRE) ================= -->
		<div class="action-bar-wrapper" style="transform: scale( @GameSettings.HudScale ); transform-origin: center bottom;">
			<!-- Flèche Page Précédente -->
			<Button class="page-nav prev @(Page == 0 ? "disabled" : "")" onclick=@PrevPage>
				◀
			</Button>

			<!-- 6 Slots d'Action (exclut les coups de poing de base) -->
			<div class="jutsu-slots-grid">
				@{
					var activeSlots = AvailableJutsus;
				}
				@for ( var slotIndex = 0; slotIndex < 6; slotIndex++ )
				{
					var actualIndex = Page * 6 + slotIndex;
					var jutsu = (activeSlots is not null && actualIndex < activeSlots.Count) ? activeSlots[actualIndex] : null;

					if ( jutsu is not null )
					{
						var cd = Caster.CooldownRemaining( jutsu );
						var noChakra = Stats.Chakra < jutsu.ChakraCost;
						var isCasting = Caster.Casting == jutsu;

						<div class="jutsu-slot @(isCasting ? "casting" : "") @(cd > 0 || noChakra ? "unavailable" : "")"
							 style="border-top-color: @Css( jutsu.FxColor ); box-shadow: 0 0 10px @(isCasting ? Css( jutsu.FxColor ) : "transparent")">
							<div class="slot-nature-strip" style="background-color: @Css( jutsu.FxColor )"></div>
							
							<div class="slot-header">
								<span class="slot-key">@(slotIndex + 1)</span>
								<span class="slot-rank">@jutsu.Rank</span>
							</div>

							<div class="slot-title">@jutsu.DisplayName</div>

							<div class="slot-cost @(noChakra ? "insufficient" : "")">
								@($"{jutsu.ChakraCost} CP")
							</div>

							@if ( cd > 0 )
							{
								<div class="slot-cooldown-overlay">
									<span class="cd-number">@MathF.Ceiling( cd )</span>
								</div>
							}
						</div>
					}
					else
					{
						<!-- Emplacement vide -->
						<div class="jutsu-slot empty">
							<div class="slot-header">
								<span class="slot-key">@(slotIndex + 1)</span>
							</div>
							<div class="empty-mark">—</div>
						</div>
					}
				}
			</div>

			<!-- Flèche Page Suivante -->
			<Button class="page-nav next @(Page >= MaxPages - 1 ? "disabled" : "")" onclick=@NextPage>
				▶
			</Button>
			
			<!-- Indicateur de page discret sous la barre -->
			<div class="page-indicator">@($"Barre {Page + 1}/{MaxPages}")</div>
		</div>
	}
</root>

@code
{
	protected override void OnAwake()
	{
		Components.GetOrCreate<MissionTrackerHud>();
		Components.GetOrCreate<MissionBoard>();
		Components.GetOrCreate<ShopMenu>();
		Components.GetOrCreate<PauseMenu>();
		GameSettings.Load();
	}

	NinjaPlayer Me => NinjaPlayer.Local;
	NinjaStats Stats => Me?.GetComponent<NinjaStats>();
	JutsuCaster Caster => Me?.GetComponent<JutsuCaster>();
	NinjaDefense Defense => Me?.GetComponent<NinjaDefense>();
	ReviveAction Revive => Me?.GetComponent<ReviveAction>();
	NinjaKunai Kunai => Me?.GetComponent<NinjaKunai>();
	NinjaShuriken Shuriken => Me?.GetComponent<NinjaShuriken>();
	NinjaInventory Inventory => Me?.GetComponent<NinjaInventory>();
	NinjaConsumables Consumables => Me?.GetComponent<NinjaConsumables>();

	int Page = 0;

	/// <summary>Portrait : une petite caméra à part, braquée sur la tête du perso, qui dessine dans une texture.</summary>
	Panel PortraitPanel { get; set; }
	CameraComponent _portraitCam;
	Texture _portraitTex;

	void UpdatePortrait()
	{
		if ( PortraitPanel is null || !Me.IsValid() ) return;
		var body = Me.Components.Get<SkinnedModelRenderer>( FindMode.EverythingInSelfAndDescendants );
		if ( body is null || !body.TryGetBoneTransform( "head", out var head ) ) return;

		if ( !_portraitCam.IsValid() )
		{
			var go = new GameObject( true, "PortraitCamera" ) { NetworkMode = NetworkMode.Never };
			_portraitTex = Texture.CreateRenderTarget( "nrp_portrait", ImageFormat.RGBA8888, new Vector2( 192, 192 ) );
			_portraitCam = go.Components.Create<CameraComponent>();
			_portraitCam.IsMainCamera = false;
			_portraitCam.FieldOfView = 30f;
			_portraitCam.ZNear = 2f;
			_portraitCam.ZFar = 150f; // ne dessine que le perso, pas la carte entière
			_portraitCam.BackgroundColor = new Color( 0.09f, 0.11f, 0.15f );
			_portraitCam.RenderTarget = _portraitTex;
		}

		var face = body.WorldRotation;
		var target = head.Position + Vector3.Up * 3f;
		_portraitCam.WorldPosition = target + face.Forward * 30f + face.Left * 8f + Vector3.Up * 1.5f;
		_portraitCam.WorldRotation = Rotation.LookAt( target - _portraitCam.WorldPosition );
		PortraitPanel.Style.SetBackgroundImage( _portraitTex );
	}

	protected override void OnDestroy()
	{
		if ( _portraitCam.IsValid() ) _portraitCam.GameObject.Destroy();
	}

	List<JutsuDefinition> AvailableJutsus => Caster?.Slots
		.Where( j => j is not null && j.Id != "base_coup_de_poing" && j.Id != "taijutsu_coup_de_poing" )
		.ToList();

	int MaxPages => Math.Max( 1, (int)MathF.Ceiling( (AvailableJutsus?.Count ?? 6) / 6f ) );

	void NextPage()
	{
		if ( Page < MaxPages - 1 ) Page++;
	}

	void PrevPage()
	{
		if ( Page > 0 ) Page--;
	}

	float HealthPct => Stats is null || Stats.MaxHealth <= 0 ? 0 : Math.Clamp( Stats.Health / Stats.MaxHealth, 0f, 1f );
	float ChakraPct => Stats is null || Stats.MaxChakra <= 0 ? 0 : Math.Clamp( Stats.Chakra / Stats.MaxChakra, 0f, 1f );
	string LevelProgressText => Me is null ? "" : $"Niv. {Me.Level + 1} dans {NinjaPlayer.FormatDuration( Me.SecondsToNextLevel )}";
	string LevelTooltip => Me is null ? "" : $"Niveau Shinobi {Me.Level} ({NinjaPlayer.FormatDuration( Me.PlayTimeSeconds )} de jeu) · {Me.SkillPoints} point(s) de compétence · Prochain niveau dans {NinjaPlayer.FormatDuration( Me.SecondsToNextLevel )} (+1 point)";

	string Notice
	{
		get
		{
			var c = Me?.GetComponent<NarutoRp.Staff.StaffCommands>();
			return c?.Notice is not null && c.NoticeAge < 6f ? c.Notice : null;
		}
	}

	ReviveAction ActiveRevive => Revive?.ReviveTarget is not null ? Revive
		: Scene.GetAllComponents<ReviveAction>().FirstOrDefault( r => r.ReviveTarget is not null && r.ReviveTarget == Stats );

	static string Css( Color c ) => $"rgba({(int)(c.r * 255)}, {(int)(c.g * 255)}, {(int)(c.b * 255)}, 1)";

	static string VillageIcon( string v ) => v?.ToLower() switch
	{
		"konoha" => "🍃",
		"suna" => "⏳",
		"kumo" => "⚡",
		_ => "🍥"
	};

	static string RankShort( string g ) => g?.ToLower() switch
	{
		"aspirant" => "ASP",
		"genin" => "GEN",
		"chunin" or "chûnin" => "CHU",
		"jonin" or "jônin" => "JON",
		"anbu" => "ANBU",
		"kage" => "KAGE",
		_ => "NIN"
	};

	Jutsus.JutsuDefinition _castSeen;
	TimeSince _castStart;
	float CastProgress => Caster?.Casting is { CastSeconds: > 0 } j ? Math.Clamp( _castStart / j.CastSeconds, 0f, 1f ) : 1f;

	protected override void OnUpdate()
	{
		var casting = Caster?.Casting;
		if ( casting != _castSeen )
		{
			_castSeen = casting;
			_castStart = 0;
		}

		UpdatePortrait();

		// Raccourci flèche gauche / droite ou touches pour paginer
		if ( !NinjaPlayer.InputBlocked )
		{
			if ( Input.Pressed( "Slot7" ) ) PrevPage();
			if ( Input.Pressed( "Slot8" ) ) NextPage();
		}
	}

	protected override int BuildHash()
	{
		var s = Stats;
		var c = Caster;
		var kCd = Kunai?.ThrowCooldownRemaining ?? 0f;
		return System.HashCode.Combine(
			System.HashCode.Combine( MathF.Round( s?.Health ?? 0 ), MathF.Round( s?.Chakra ?? 0 ), Me?.Ryo, Page ),
			System.HashCode.Combine( s?.IsDowned, s?.IsStunned, c?.Casting, Notice, Me?.Grade, Me?.IsMedic, Me?.GetComponent<NinjaMovement>()?.IsNinjaRunning ),
			System.HashCode.Combine( Defense?.IsGuarding, Defense?.IsSubstitutionReady, MathF.Ceiling( Defense?.SubstitutionCooldownRemaining ?? 0 ), kCd > 0, MathF.Ceiling( kCd ) ),
			c?.Slots.Sum( j => j is null ? 0f : MathF.Ceiling( c.CooldownRemaining( j ) ) ),
			System.HashCode.Combine( Me?.GetComponent<NarutoRp.Staff.StaffCommands>()?.IsFlying, Me?.GetComponent<NarutoRp.Staff.StaffCommands>()?.FlySpeed ),
			c is null ? 0 : c.Slots.Aggregate( 17, ( h, j ) => System.HashCode.Combine( h, j?.Id ) ),
			// HashCode.Combine prend 8 valeurs au plus : le reste est regroupé ici.
			System.HashCode.Combine(
				System.HashCode.Combine( s?.MaxHealth, Me?.CharacterName, Me?.Level, Me?.PlayTimeSeconds ),
				System.HashCode.Combine( Consumables?.DeployedTagCount, MathF.Ceiling( Consumables?.ExplosiveTagCooldownRemaining ?? 0 ), MathF.Ceiling( Consumables?.SmokeBombCooldownRemaining ?? 0 ) ),
				System.HashCode.Combine( MathF.Ceiling( Shuriken?.ThrowCooldownRemaining ?? 0 ), Inventory?.Serialize(), Inventory?.SoldierPillCooldown > 0, GameSettings.HudScale, GameSettings.HudVisible, Kunai?.IsDrawn ),
				MathF.Round( CastProgress * 40 ) ) );
	}
}
